--- !u!114 &220593970
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 220593968}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 55c24004838261046b4b1c54c3d27b25, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 82504120}
  dialogueText: {fileID: 1098946165}
  dialogue:
  - "Ho\u015F geldin, evlat. Ben de seni bekliyordum."
  - "Seni iyile\u015Ftirecek panzehir bu topraklarda de\u011Fil."
  - "Kimsenin ge\xE7medi\u011Fi sular\u0131 ge\xE7meli ve sana verdi\u011Fim panzehiri
    almak i\xE7in di\u011Fer \xE2leme gitmelisin."
  - "Baban panzehirin bu alemde oldu\u011Funu d\xFC\u015F\xFCn\xFCyor. Ben de ona
    \xF6yle s\xF6yledim."
  - "Kehanetlere g\xF6re, hi\xE7bir g\xFC\xE7 o engin sular\u0131 ge\xE7emez. Sen
    hari\xE7, \xE7\xFCnk\xFC kehanetteki ki\u015Fi sensin. Kral\u0131n s\xFCper parkur
    becerilerine sahip o\u011Flu."
  - "Panzehire uzan ve sald\u0131r\u0131 g\xFC\xE7lerini geri kazan evlat. Diyar\u0131n
    kaderi senin ellerinde."
  wordSpeed: 0.02
  playerIsClose: 0
